--TEST--
Cooldown policy withholding the fix for an advisory-blocked version explains how to get the fix without waiting.
--COMPOSER--
{
    "name": "acme/project",
    "version": "1.0.0",
    "require": {
        "acme/library": "^1.0"
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            },
            "cooldown": {
                "period": "1 week"
            }
        }
    },
    "repositories": [
        {
            "type": "package",
            "package": [
                {
                    "name": "acme/library",
                    "version": "1.0.0",
                    "published-time": "2020-01-01T00:00:00+00:00",
                    "source": { "reference": "1.0.0", "type": "git", "url": "" }
                },
                {
                    "name": "acme/library",
                    "version": "1.0.1",
                    "published-time": "2999-01-01T00:00:00+00:00",
                    "source": { "reference": "1.0.1", "type": "git", "url": "" }
                }
            ],
            "security-advisories": {
                "acme/library": [
                    {
                        "advisoryId": "PKSA-1234-abcd-1234",
                        "packageName": "acme/library",
                        "remoteId": "test",
                        "title": "Security Advisory",
                        "link": null,
                        "cve": null,
                        "affectedVersions": "<1.0.1",
                        "source": "Tests",
                        "reportedAt": "2024-04-31 12:37:47",
                        "composerRepository": "Package Repository",
                        "severity": "high",
                        "sources": [
                            {
                                "name": "Security Advisory",
                                "remoteId": "test"
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
--RUN--
update -v

--EXPECT-EXIT-CODE--
2

--EXPECT-OUTPUT--
Loading composer repositories with package information
<warning>1 package version(s) withheld by the cooldown policy (run with -vv to list them).</warning>
Updating dependencies
Your requirements could not be resolved to an installable set of packages.

  Problem 1
    - Root composer.json requires acme/library ^1.0, found acme/library[1.0.0, 1.0.1] but these were not loaded, because:
      - 1.0.0: affected by security advisories ("PKSA-1234-abcd-1234")
      - 1.0.1: still in the cooldown period configured in "policy.cooldown" (available in %s)
      Go to https://packagist.org/security-advisories/ to find advisory details. To ignore the advisories, add their IDs to the "policy.advisories.ignore-id" config or add the package to "policy.advisories.ignore". To exempt the package from the cooldown policy, add it to the "policy.cooldown.ignore" config, or run the update with COMPOSER_POLICY_COOLDOWN_PERIOD=0 for a one-off bypass. To turn a policy off entirely, you can set "policy.advisories.block" or "policy.cooldown.block" to false.

--EXPECT--
