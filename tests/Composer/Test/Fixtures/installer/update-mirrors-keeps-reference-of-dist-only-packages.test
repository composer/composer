--TEST--
Update mirrors keeps the locked reference of packages which only have a dist and no source

a/a is a tag whose dist was rebuilt, it keeps its ref and URL as the URL is not in a known format
b/b is dev and keeps its ref, the GitHub URL is updated with the old ref
c/c has the same ref but its dist moved to a new host, so it gets the new URL and shasum
d/d was dist-only in the lock and now has a source, it keeps its old ref, stays dist-only and gets the new GitHub URL
e/e is a path repo package and gets fully refreshed
--COMPOSER--
{
    "repositories": [
        {
            "type": "package",
            "package": [
                {
                    "name": "a/a", "version": "1.0.0",
                    "dist": { "reference": "2222222222222222222222222222222222222222", "url": "https://example.org/dists/a/a/1.0.0/2222222222222222222222222222222222222222.zip", "type": "zip" }
                },
                {
                    "name": "b/b", "version": "dev-main",
                    "dist": { "reference": "2222222222222222222222222222222222222222", "url": "https://api.github.com/repos/b/newb/zipball/2222222222222222222222222222222222222222", "type": "zip" }
                },
                {
                    "name": "c/c", "version": "1.0.0",
                    "dist": { "reference": "1111111111111111111111111111111111111111", "url": "https://new.example.org/dists/c/c/1.0.0.zip", "type": "zip", "shasum": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }
                },
                {
                    "name": "d/d", "version": "dev-main",
                    "source": { "reference": "2222222222222222222222222222222222222222", "url": "https://github.com/d/d", "type": "git" },
                    "dist": { "reference": "2222222222222222222222222222222222222222", "url": "https://api.github.com/repos/d/d/zipball/2222222222222222222222222222222222222222", "type": "zip" }
                },
                {
                    "name": "e/e", "version": "dev-main",
                    "dist": { "reference": "2222222222222222222222222222222222222222", "url": "../e-new", "type": "path" }
                }
            ]
        }
    ],
    "require": {
        "a/a": "1.0.0",
        "b/b": "dev-main",
        "c/c": "1.0.0",
        "d/d": "dev-main",
        "e/e": "dev-main"
    }
}
